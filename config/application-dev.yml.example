# 개발용 비밀 설정의 틀 (T088 메일, T099·T100 카카오·구글 로그인)
#
# 쓰는 법
#   cp config/application-dev.yml.example config/application-dev.yml
#   그다음 config/application-dev.yml의 빈 값을 채운다. 이 파일은 git에 올라가지 않는다(.gitignore).
#
# Spring Boot는 dev 프로필(기본)로 실행하면 ./config/application-dev.yml을 저절로 읽고,
# src/main/resources/application-dev.yml(모두가 같이 쓰는 개발 기본값)보다 이 파일의 값을 먼저 쓴다.
# 그래서 여기에는 사람마다 다른 값과 비밀 값만 둔다.
#
# 비밀 값은 대화창·이슈·PR에 붙이지 않는다. 새었으면 각 콘솔에서 다시 만든다.

app:
  oauth:
    # 콜백(리다이렉트 URI)은 localhost여도 된다. 서버가 코드를 받은 뒤 로그인을 시작한 blog.test 주소로 다시 보내
    # 거기서 로그인 쿠키를 준다. 구글은 https가 아니면 localhost만 받으므로 개발에서는 localhost로 둔다.
    # 카카오 developers → 내 애플리케이션 → 앱 키의 REST API 키, 클라이언트 시크릿(활성화 ON)
    kakao:
      client-id: ""
      client-secret: ""
      # 카카오 콘솔에 등록한 리다이렉트 URI와 글자 하나까지 같아야 한다
      redirect-uri: http://localhost:8080/api/auth/oauth/kakao/callback
    # Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹 애플리케이션)
    google:
      client-id: ""
      client-secret: ""
      # 구글 콘솔의 "승인된 리디렉션 URI"와 같아야 한다
      redirect-uri: http://localhost:8080/api/auth/oauth/google/callback

  mail:
    # 메일을 보내는 방법
    #   log  : 보내지 않고 서버 로그에만 남긴다(지금까지의 방식)
    #   smtp : 아래 spring.mail로 실제 발송(Mailpit 또는 Gmail)
    sender: smtp
    # 받는 사람에게 보이는 보낸 사람. Gmail이면 그 Gmail 주소와 같게 둔다
    from: "now-log <no-reply@blog.test>"

# 메일 서버(SMTP). 둘 중 하나만 켠다.
spring:
  mail:
    # ① Mailpit(개발용 가짜 메일함, docker compose up -d로 함께 뜬다). 보낸 메일은 http://localhost:8025 에서 본다
    host: localhost
    port: 1025

    # ② Gmail(실제 메일함으로 발송). 위 ①의 host·port를 지우고 아래 주석을 푼다.
    #    password는 Gmail 비밀번호가 아니라 "앱 비밀번호"(16자리, 2단계 인증을 켠 계정에서 만든다)
    # host: smtp.gmail.com
    # port: 587
    # username: ""
    # password: ""
    # properties:
    #   mail:
    #     smtp:
    #       auth: true
    #       starttls:
    #         enable: true
